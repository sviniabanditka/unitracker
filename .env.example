# Reserved for future use (signed download tokens, CSRF, etc.).
# Sessions themselves use random server-side IDs and do not need this.
# SESSION_SECRET=change-me-to-a-long-random-string-32-bytes-or-more

# Bootstrap admin (used only when users table is empty on first startup).
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-on-first-login

# Storage location for app.db and snapshots. Optional; default /data inside the container.
# DATA_DIR=/data

# HTTP listen address. Optional; default :8080.
# HTTP_ADDR=:8080

# Set to "true" when serving over HTTPS (adds Secure flag to session cookie).
# Optional; default false.
# COOKIE_SECURE=false

# Container time zone. Optional; default UTC.
# TZ=Europe/Kyiv
